# ============================================================
# Nora Interviewer — development configuration
# ============================================================

# ------------------------------------------------------------
# Interview brain
# ------------------------------------------------------------

# Deterministic local/default mode.
NORA_BRAIN_MODE=rule

# OpenAI-compatible interviewer mode:
# NORA_BRAIN_MODE=openai-compatible
# NORA_LLM_BASE_URL=https://your-provider.example/v1
# NORA_LLM_MODEL=your-interviewer-model
# NORA_LLM_API_KEY=replace-me

# ------------------------------------------------------------
# Independent semantic Evidence Judge
# ------------------------------------------------------------

# Disabled by default. Evidence judging is intentionally opt-in
# and independently configured from the interviewer brain.
NORA_EVIDENCE_JUDGE_MODE=disabled

# OpenAI-compatible evidence judge:
# NORA_EVIDENCE_JUDGE_MODE=openai-compatible
# NORA_EVIDENCE_JUDGE_BASE_URL=https://your-judge-provider.example/v1
# NORA_EVIDENCE_JUDGE_MODEL=your-independent-judge-model
# NORA_EVIDENCE_JUDGE_API_KEY=replace-me
#
# Multi-model evidence ensemble using the same OpenAI-compatible endpoint:
# NORA_EVIDENCE_JUDGE_MODE=ensemble
# NORA_EVIDENCE_JUDGE_BASE_URL=https://your-judge-provider.example/v1
# NORA_EVIDENCE_JUDGE_MODELS=judge-model-a,judge-model-b,judge-model-c
# NORA_EVIDENCE_JUDGE_AGREEMENT_THRESHOLD=0.67
# NORA_EVIDENCE_JUDGE_API_KEY=replace-me

# ------------------------------------------------------------
# Coding sandbox
# ------------------------------------------------------------

# disabled | docker
NORA_SANDBOX_MODE=disabled

# Optional Docker image override:
# NORA_SANDBOX_IMAGE=python:3.12-alpine

# ------------------------------------------------------------
# Authorization / principal resolution
# ------------------------------------------------------------

# disabled | dev-header | jwt-jwks
#
# disabled:
#   Backward-compatible local/demo mode. Every request is treated
#   as the trusted local service principal.
#
# dev-header:
#   Development-only role simulation using:
#     X-Nora-Principal
#     X-Nora-Role
#     X-Nora-Candidate-Ref   (candidate role only)
#
# Do not use dev-header as production authentication.
NORA_AUTH_MODE=disabled

# Production-style Bearer JWT validation through a remote JWKS:
# NORA_AUTH_MODE=jwt-jwks
# NORA_AUTH_JWKS_URL=https://identity.example/.well-known/jwks.json
# NORA_AUTH_ISSUER=https://identity.example/
# NORA_AUTH_AUDIENCE=https://api.nora.example
# NORA_AUTH_ALGORITHMS=RS256
# NORA_AUTH_PRINCIPAL_CLAIM=sub
# NORA_AUTH_ROLE_CLAIM=nora_role
# NORA_AUTH_CANDIDATE_REF_CLAIM=candidate_ref
# NORA_AUTH_LEEWAY_SECONDS=30
#
# Service-role JWTs are denied by default:
# NORA_AUTH_ALLOW_SERVICE_ROLE=false
#
# Only for local/dev identity servers using http://:
# NORA_AUTH_ALLOW_INSECURE_JWKS=true

# ------------------------------------------------------------
# Persistence
# ------------------------------------------------------------

# memory | sqlite | postgres
NORA_STORE_MODE=memory

# Used only when NORA_STORE_MODE=sqlite
# NORA_SQLITE_PATH=.nora/nora.db

# Multi-instance PostgreSQL mode:
# NORA_STORE_MODE=postgres
# NORA_POSTGRES_DSN=postgresql://nora:password@postgres.example/nora
# NORA_POSTGRES_MIN_SIZE=1
# NORA_POSTGRES_MAX_SIZE=10
# NORA_POSTGRES_TIMEOUT_SECONDS=30
